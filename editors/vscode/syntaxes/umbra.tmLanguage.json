{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Umbra",
  "scopeName": "source.umbra",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-declaration" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.umbra",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.umbra",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.umbra",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.umbra",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.declaration.umbra storage.type.umbra" },
        "2": { "name": "entity.name.function.umbra" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.umbra",
          "match": "\\b(if|else|while|for|in|return|match)\\b"
        },
        {
          "name": "keyword.declaration.umbra storage.type.umbra",
          "match": "\\b(let|mut|fn)\\b"
        },
        {
          "name": "keyword.operator.logical.umbra",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.umbra",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.umbra",
          "match": "\\b(print|len|clock|push|pop|str|type)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.umbra",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.umbra",
          "match": "(==|!=|<=|>=|=|<|>|\\+|\\-|\\*|/|!|\\?|:)"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.umbra" }
      }
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.umbra",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
