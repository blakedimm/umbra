// --- 1. Exact Integer Math & Deterministic 32-bit LCG PRNG ------------------

mut rngState = 133742;

fn mod(a, m) {
    mut rem = a;
    mut step = m;
    while (step <= rem) {
        step = step * 2;
    }
    while (step >= m) {
        if (rem >= step) {
            rem = rem - step;
        }
        step = step / 2;
    }
    return rem;
}

fn floor(x) {
    if (x <= 0) {
        return 0;
    }
    mut rem = x;
    mut bit = 1;
    while (bit <= rem) {
        bit = bit * 2;
    }
    mut result = 0;
    while (bit >= 1) {
        if (rem >= bit) {
            rem = rem - bit;
            result = result + bit;
        }
        bit = bit / 2;
    }
    return result;
}

// Numerical Recipes 32-bit LCG: X_{n+1} = (1664525 * X_n + 1013904223) mod 2^32
fn nextRand() {
    rngState = mod(rngState * 1664525 + 1013904223, 4294967296);
    return rngState;
}

fn randRange(limit) {
    let r = nextRand();
    return mod(floor(r / 65536), limit);
}

// --- 2. 2D Matrix Initialization --------------------------------------------
// Tile codes:
// 0 = Floor (.)
// 1 = Wall  (#)
// 2 = Player (@)
// 3 = Loot   ($)
// 4 = Mob    (M)
// 5 = Portal (>)

fn createNoiseMap(width, height, wallProbPercent) {
    mut grid = [];
    mut y = 0;
    while (y < height) {
        mut row = [];
        mut x = 0;
        while (x < width) {
            if (x == 0 or y == 0 or x == width - 1 or y == height - 1) {
                push(row, 1);
            } else {
                if (randRange(100) < wallProbPercent) {
                    push(row, 1);
                } else {
                    push(row, 0);
                }
            }
            x = x + 1;
        }
        push(grid, row);
        y = y + 1;
    }
    return grid;
}

// --- 3. Cellular Automata (4-5 Rule) Smoothing ------------------------------

fn countWallNeighbors(grid, cx, cy, width, height) {
    mut count = 0;
    mut dy = -1;
    while (dy <= 1) {
        mut dx = -1;
        while (dx <= 1) {
            if (not (dx == 0 and dy == 0)) {
                let nx = cx + dx;
                let ny = cy + dy;
                if (nx < 0 or ny < 0 or nx >= width or ny >= height) {
                    count = count + 1;
                } else {
                    if (grid[ny][nx] == 1) {
                        count = count + 1;
                    }
                }
            }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    return count;
}

fn smoothStep(grid) {
    let height = len(grid);
    let width = len(grid[0]);
    mut nextGrid = [];

    mut y = 0;
    while (y < height) {
        mut nextRow = [];
        mut x = 0;
        while (x < width) {
            if (x == 0 or y == 0 or x == width - 1 or y == height - 1) {
                push(nextRow, 1);
            } else {
                let neighbors = countWallNeighbors(grid, x, y, width, height);
                let current = grid[y][x];
                // 4-5 Cellular Automata rule:
                // Wall survives if >= 4 wall neighbors; Floor becomes Wall if >= 5 wall neighbors
                if (current == 1) {
                    if (neighbors >= 4) {
                        push(nextRow, 1);
                    } else {
                        push(nextRow, 0);
                    }
                } else {
                    if (neighbors >= 5) {
                        push(nextRow, 1);
                    } else {
                        push(nextRow, 0);
                    }
                }
            }
            x = x + 1;
        }
        push(nextGrid, nextRow);
        y = y + 1;
    }
    return nextGrid;
}

// --- 4. Procedural Entity Spawning ------------------------------------------

fn spawnRandomEntities(grid, tileType, targetCount) {
    let height = len(grid);
    let width = len(grid[0]);
    mut spawned = 0;
    mut attempts = 0;

    while (spawned < targetCount and attempts < 500) {
        let rx = 1 + randRange(width - 2);
        let ry = 1 + randRange(height - 2);
        if (grid[ry][rx] == 0) {
            grid[ry][rx] = tileType;
            spawned = spawned + 1;
        }
        attempts = attempts + 1;
    }
    return spawned;
}

fn placePlayerStart(grid) {
    let height = len(grid);
    let width = len(grid[0]);
    mut y = 1;
    while (y < height - 1) {
        mut x = 1;
        while (x < width - 1) {
            if (grid[y][x] == 0) {
                grid[y][x] = 2;
                return [x, y];
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return [1, 1];
}

fn placeExitPortal(grid) {
    let height = len(grid);
    let width = len(grid[0]);
    mut y = height - 2;
    while (y >= 1) {
        mut x = width - 2;
        while (x >= 1) {
            if (grid[y][x] == 0) {
                grid[y][x] = 5;
                return [x, y];
            }
            x = x - 1;
        }
        y = y - 1;
    }
    return [width - 2, height - 2];
}

// --- 5. ASCII Renderer & World Telemetry ------------------------------------

fn tileToChar(tile) {
    if (tile == 1) { return "#"; }
    if (tile == 0) { return "."; }
    if (tile == 2) { return "@"; }
    if (tile == 3) { return "$"; }
    if (tile == 4) { return "M"; }
    if (tile == 5) { return ">"; }
    return "?";
}

fn renderHorizontalBorder(width) {
    mut border = "+";
    mut i = 0;
    while (i < width) {
        border = border + "-";
        i = i + 1;
    }
    border = border + "+";
    print border;
}

fn renderMap(grid) {
    let width = len(grid[0]);
    renderHorizontalBorder(width);

    for (row in grid) {
        mut lineStr = "|";
        for (cell in row) {
            lineStr = lineStr + tileToChar(cell);
        }
        lineStr = lineStr + "|";
        print lineStr;
    }

    renderHorizontalBorder(width);
}

fn countTileType(grid, targetTile) {
    mut count = 0;
    for (row in grid) {
        for (cell in row) {
            if (cell == targetTile) {
                count = count + 1;
            }
        }
    }
    return count;
}

// --- 6. Main Simulation Execution -------------------------------------------

print "======================================================";
print "   AETHER: PROCEDURAL WORLD SIMULATOR (Umbra v1.0.0)  ";
print "======================================================";

let startClock = clock();

let mapWidth = 52;
let mapHeight = 20;
let initialWallPercent = 45;
let initialSeed = rngState;

// Generate initial noise matrix and run 4-pass Cellular Automata via pipeline |>
let worldMap = createNoiseMap(mapWidth, mapHeight, initialWallPercent)
    |> smoothStep
    |> smoothStep
    |> smoothStep
    |> smoothStep;

// Spawn entities into the generated cavern
let playerPos = placePlayerStart(worldMap);
let portalPos = placeExitPortal(worldMap);
let lootCount = spawnRandomEntities(worldMap, 3, 10);
let mobCount  = spawnRandomEntities(worldMap, 4, 8);

let elapsedMs = floor((clock() - startClock) * 100000) / 100;

// Render the generated cavern
renderMap(worldMap);

// Compute world metrics
let totalCells = mapWidth * mapHeight;
let wallCells = countTileType(worldMap, 1);
let openCells = totalCells - wallCells;
let rockDensity = floor((wallCells * 1000) / totalCells) / 10;

print "Legend: [#] Wall  [.] Floor  [@] Player  [$] Loot  [M] Mob  [>] Portal";
print "------------------------------------------------------";
print "World Seed        : " + str(initialSeed);
print "Map Dimensions    : " + str(mapWidth) + "x" + str(mapHeight) + " (" + str(totalCells) + " cells)";
print "CA Smoothing      : 4 passes (Rule 4-5 via |> pipeline)";
print "Rock Density      : " + str(rockDensity) + "% (" + str(wallCells) + " walls / " + str(openCells) + " open)";
print "Player Spawn (@)  : [" + str(playerPos[0]) + ", " + str(playerPos[1]) + "]";
print "Exit Portal  (>)  : [" + str(portalPos[0]) + ", " + str(portalPos[1]) + "]";
print "Spawned Entities  : " + str(lootCount) + " Loot ($), " + str(mobCount) + " Mobs (M)";
print "Generation Time   : " + str(elapsedMs) + " ms";
print "Simulation Status : READY (Cavern Integrity Verified)";
print "======================================================";
